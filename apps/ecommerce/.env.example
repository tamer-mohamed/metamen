# Kashier test-mode credentials (from the Kashier dashboard, test mode).
# Server-only — never prefix any of these with NEXT_PUBLIC_.
# If a value contains a literal '$', escape it as '\$' — Next.js expands
# unescaped $VARIABLE references in .env files (see its own docs).
KASHIER_TEST_SECRET_KEY=
KASHIER_TEST_API_KEY=
KASHIER_TEST_MERCHANT_ID=

# Kashier rejects "localhost" as a merchantRedirect hostname. For local dev,
# expose this app via a tunnel (e.g. `ngrok http 3000`) and set this to the
# tunnel's public HTTPS URL. Leave unset in production — the app falls back
# to the real request origin.
PUBLIC_APP_URL=
